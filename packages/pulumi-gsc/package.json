    "LICENSE"
  ],
  "keywords": [
    "pulumi",
    "provider",
    "gsc",
    "infrastructure"
  ],
  "author": {
    "name": "Sargon Piraev",
    "email": "sargonpiraev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargonpiraev/shared.git",
    "directory": "packages/pulumi-gsc"
  },
  "homepage": "https://github.com/sargonpiraev/shared/tree/main/packages/pulumi-gsc#readme",
  "bugs": {
    "url": "https://github.com/sargonpiraev/shared/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
