{
  "name": "@sargonpiraev/alint-config",
  "version": "0.0.0",
  "description": "Shared alint FS-structure rules for sargonpiraev product project roots",
  "exports": {
    "./project.yml": "./project.yml",
    "./project": "./project.yml"
  },
  "files": [
    "project.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "alint",
    "alint-config",
    "filesystem",
    "structure"
  ],
  "author": {
    "name": "Sargon Piraev",
    "email": "sargonpiraev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargonpiraev/packages.git",
    "directory": "packages/alint-config"
  },
  "homepage": "https://github.com/sargonpiraev/packages/tree/main/packages/alint-config#readme",
  "bugs": {
    "url": "https://github.com/sargonpiraev/packages/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node -e \"console.log('noop build'); process.exit(0)\"",
    "check-types": "node -e \"console.log('noop check-types'); process.exit(0)\"",
    "lint": "node -e \"console.log('noop lint'); process.exit(0)\"",
    "test": "node -e \"const fs=require('fs'); const t=fs.readFileSync('./project.yml','utf8'); if(!t.includes('id: project')||!t.includes('id: turborepo')) process.exit(1)\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@asamarts/alint": ">=0.14.0"
  }
}
