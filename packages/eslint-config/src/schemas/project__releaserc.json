{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product/package .releaserc.json",
  "description": "semantic-release must thin-extend @sargonpiraev/semantic-release-config (including that package’s own .releaserc.json). Local overlays (plugins, branches, …) optional. No npm token fields. Shipped by @sargonpiraev/eslint-config.",
  "type": "object",
  "required": ["extends"],
  "properties": {
    "extends": {
      "anyOf": [
        { "const": "@sargonpiraev/semantic-release-config" },
        {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "@sargonpiraev/semantic-release-config"
          }
        }
      ]
    },
    "branches": {
      "type": "array",
      "minItems": 1
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "items": [{ "type": "string", "minLength": 1 }]
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
