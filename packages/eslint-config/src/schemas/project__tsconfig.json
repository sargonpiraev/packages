{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product root tsconfig",
  "description": "Root tsconfig.json must extend @sargonpiraev/tsconfig (strict: true in the shared base). If compilerOptions.strict is set locally it must be true. Shipped by @sargonpiraev/eslint-config.",
  "type": "object",
  "required": ["extends"],
  "properties": {
    "extends": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^@sargonpiraev/tsconfig(/base(\\.json)?)?$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "contains": {
            "type": "string",
            "pattern": "^@sargonpiraev/tsconfig(/base(\\.json)?)?$"
          }
        }
      ]
    },
    "compilerOptions": {
      "type": "object",
      "properties": {
        "strict": { "const": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
