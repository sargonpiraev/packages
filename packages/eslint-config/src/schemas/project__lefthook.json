{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project lefthook.yml",
  "description": "Project lefthook must pull shared hooks from sargonpiraev/shared via remotes (configs: ci/lefthook.yml). Do not duplicate commit-msg / pre-push command bodies; pre-push.exclude_tags (e.g. audit) in this file is OK. Do not commit lefthook-local.yml (gitignore personal overrides). See .cursor/rules/git__lefthook.mdc.",
  "type": "object",
  "required": ["remotes"],
  "properties": {
    "remotes": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["git_url", "configs"],
        "properties": {
          "git_url": {
            "type": "string",
            "pattern": "github\\.com[/:]sargonpiraev/shared(?:\\.git)?/?$"
          },
          "ref": { "type": "string", "minLength": 1 },
          "configs": {
            "type": "array",
            "minItems": 1,
            "contains": { "const": "ci/lefthook.yml" },
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      },
      "items": {
        "type": "object",
        "required": ["git_url", "configs"],
        "properties": {
          "git_url": { "type": "string", "minLength": 1 },
          "ref": { "type": "string" },
          "configs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
