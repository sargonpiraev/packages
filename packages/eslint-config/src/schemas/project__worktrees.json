{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Cursor worktrees.json",
  "description": "Required Cursor worktree setup shape for project .cursor/worktrees.json. At least one of setup-worktree | setup-worktree-unix | setup-worktree-windows. Shipped by @sargonpiraev/eslint-config.",
  "type": "object",
  "anyOf": [
    { "required": ["setup-worktree"] },
    { "required": ["setup-worktree-unix"] },
    { "required": ["setup-worktree-windows"] }
  ],
  "properties": {
    "setup-worktree": { "$ref": "#/$defs/setupCommands" },
    "setup-worktree-unix": { "$ref": "#/$defs/setupCommands" },
    "setup-worktree-windows": { "$ref": "#/$defs/setupCommands" }
  },
  "additionalProperties": true,
  "$defs": {
    "setupCommands": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    }
  }
}
