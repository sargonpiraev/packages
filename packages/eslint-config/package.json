{
  "name": "@sargonpiraev/eslint-config",
  "version": "0.0.0",
  "description": "Shared ESLint flat-config presets and JSON schemas for project harness / test:* inventory gates",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./project": {
      "types": "./build/project.d.ts",
      "import": "./build/project.js"
    },
    "./project-meta": {
      "types": "./build/project-meta.d.ts",
      "import": "./build/project-meta.js"
    },
    "./schemas/*": "./build/schemas/*"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "json-schema",
    "playwright",
    "nx",
    "harness"
  ],
  "author": {
    "name": "Sargon Piraev",
    "email": "sargonpiraev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargonpiraev/packages.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/sargonpiraev/packages/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/sargonpiraev/packages/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p build/schemas && cp src/schemas/*.json build/schemas/",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ./src --ext .ts",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test build/__tests__/create-project-configs.test.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "eslint-plugin-json-schema-validator": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.33",
    "eslint": "^9.26.0",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "typescript": "^5.8.3"
  }
}
