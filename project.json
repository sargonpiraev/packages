{
  "name": "packages",
  "$schema": "../schema/project__project.json",
  "projectType": "library",
  "tags": [
    "shared",
    "type:lib",
    "stack:npm",
    "status:active"
  ],
  "metadata": {
    "description": "Public npm packages (API clients, Pulumi providers, MCP servers)",
    "technologies": [
      "typescript",
      "turbo",
      "npm"
    ]
  },
  "targets": {
    "lint": {
      "cache": false,
      "command": "npm run lint",
      "options": {
        "cwd": "packages"
      }
    },
    "check-types": {
      "cache": false,
      "command": "npm run check-types",
      "options": {
        "cwd": "packages"
      }
    },
    "build": {
      "cache": false,
      "command": "npm run build",
      "options": {
        "cwd": "packages"
      }
    },
    "test": {
      "cache": false,
      "command": "npm run test",
      "options": {
        "cwd": "packages"
      }
    },
    "test:unit": {
      "cache": false,
      "command": "npm run test:unit",
      "options": {
        "cwd": "packages"
      }
    },
    "test:lint": {
      "cache": false,
      "command": "npm run test:lint",
      "options": {
        "cwd": "packages"
      }
    },
    "test:check-types": {
      "cache": false,
      "command": "npm run test:check-types",
      "options": {
        "cwd": "packages"
      }
    },
    "test:spec": {
      "cache": false,
      "command": "npm run test:spec",
      "options": {
        "cwd": "packages"
      }
    },
    "test:visual": {
      "cache": false,
      "command": "npm run test:visual",
      "options": {
        "cwd": "packages"
      }
    },
    "test:format": {
      "cache": false,
      "command": "npm run test:format",
      "options": {
        "cwd": "packages"
      }
    },
    "git:status": {
      "cache": false,
      "command": "git status -sb",
      "options": {
        "cwd": "packages"
      }
    }
  }
}
