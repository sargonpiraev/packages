{
  "name": "packages",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["shared", "type:lib", "stack:npm", "status:active"],
  "metadata": {
    "description": "Public npm packages (API clients, Pulumi providers, MCP servers)",
    "technologies": ["typescript", "turbo", "npm"]
  },
  "targets": {
    "lint": {
      "cache": false,
      "command": "npm run lint",
      "options": { "cwd": "packages" }
    },
    "check-types": {
      "cache": false,
      "command": "npm run check-types",
      "options": { "cwd": "packages" }
    },
    "build": {
      "cache": false,
      "command": "npm run build",
      "options": { "cwd": "packages" }
    },
    "test": {
      "cache": false,
      "command": "npm run test",
      "options": { "cwd": "packages" }
    }
  }
}
