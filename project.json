{
  "name": "shared",
  "$schema": "./node_modules/@sargonpiraev/eslint-config/build/schemas/project__project.json",
  "projectType": "library",
  "tags": [
    "shared",
    "type:lib",
    "stack:npm",
    "status:active"
  ],
  "metadata": {
    "description": "Shared monorepo: public npm packages + reusable GitHub Actions / Lefthook baseline (merged from packages + ci)",
    "technologies": [
      "typescript",
      "turbo",
      "npm",
      "github-actions",
      "lefthook"
    ]
  },
  "targets": {
    "lint": {
      "cache": false,
      "command": "npm run lint",
      "options": {
        "cwd": "shared"
      }
    },
    "check-types": {
      "cache": false,
      "command": "npm run check-types",
      "options": {
        "cwd": "shared"
      }
    },
    "build": {
      "cache": false,
      "command": "npm run build",
      "options": {
        "cwd": "shared"
      }
    },
    "test": {
      "cache": false,
      "command": "npm run test",
      "options": {
        "cwd": "shared"
      }
    },
    "test:unit": {
      "cache": false,
      "command": "npm run test:unit",
      "options": {
        "cwd": "shared"
      }
    },
    "test:lint": {
      "cache": false,
      "command": "npm run test:lint",
      "options": {
        "cwd": "shared"
      }
    },
    "test:check-types": {
      "cache": false,
      "command": "npm run test:check-types",
      "options": {
        "cwd": "shared"
      }
    },
    "test:spec": {
      "cache": false,
      "command": "npm run test:spec",
      "options": {
        "cwd": "shared"
      }
    },
    "test:visual": {
      "cache": false,
      "command": "npm run test:visual",
      "options": {
        "cwd": "shared"
      }
    },
    "test:format": {
      "cache": false,
      "command": "npm run test:format",
      "options": {
        "cwd": "shared"
      }
    },
    "git:status": {
      "cache": false,
      "command": "git status -sb",
      "options": {
        "cwd": "shared"
      }
    },
    "test:alint": {
      "cache": false,
      "command": "npm run test:alint",
      "options": {
        "cwd": "shared"
      }
    }
  }
}
