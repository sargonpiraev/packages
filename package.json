{
  "name": "packages",
  "private": true,
  "description": "Public npm packages: API clients, Pulumi providers, MCP servers",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "release": "multi-semantic-release",
    "prepare": "lefthook install",
    "test:unit": "turbo run test",
    "test:lint": "eslint --config ./eslint.config.mjs --no-config-lookup --no-warn-ignored --no-error-on-unmatched-pattern \"project.json\" \"package.json\" \".cursor/worktrees.json\" \"repo.harness.json\" \"env.harness.json\" \"pulumi.harness.json\" \"tsconfig.json\" \"tsconfig.base.json\" \".releaserc.json\" \".github/workflows/on-push-main.yml\" \"playwright.harness.json\" \"apps/*/playwright.harness.json\" \".gitignore\" && npm run lint",
    "test:check-types": "npm run check-types",
    "test:spec": "node -e \"console.log('noop test:spec \u2014 N/A'); process.exit(0)\"",
    "test:visual": "node -e \"console.log('noop test:visual \u2014 N/A'); process.exit(0)\"",
    "test:format": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.26.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lefthook": "^2.1.9",
    "multi-semantic-release": "^3.0.2",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.3.2",
    "turbo": "^2.10.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.31.1",
    "@sargonpiraev/prettier-config": "file:packages/prettier-config",
    "@sargonpiraev/tsconfig": "file:packages/tsconfig",
    "@sargonpiraev/eslint-config": "file:packages/eslint-config",
    "eslint-plugin-json-schema-validator": "^6.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "$schema": "../schema/project__package.json",
  "prettier": "@sargonpiraev/prettier-config"
}
