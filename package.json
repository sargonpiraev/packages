{
  "$schema": "./node_modules/@sargonpiraev/eslint-config/build/schemas/project__package.json",
  "name": "shared",
  "private": true,
  "description": "Shared monorepo: public npm packages + reusable GitHub Actions / Lefthook baseline",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "prepare": "lefthook install",
    "release": "multi-semantic-release --ignore-packages=packages/pulumi-ga4/**",
    "test": "turbo run test",
    "test:alint": "alint check",
    "test:check-types": "npm run check-types",
    "test:format": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "test:eslint": "npm run build -w @sargonpiraev/eslint-config && eslint --config ./eslint.config.mjs --no-config-lookup --no-warn-ignored --no-error-on-unmatched-pattern \"project.json\" \"package.json\" \".cursor/worktrees.json\" \"tsconfig.json\" \".releaserc.json\" \"packages/*/.releaserc.json\" \"playwright.config.ts\" \"apps/*/playwright.config.ts\" \".gitignore\" && npm run lint",
    "test:spec": "node -e \"console.log('noop test:spec — N/A'); process.exit(0)\"",
    "test:unit": "turbo run test",
    "test:visual": "node -e \"console.log('noop test:visual — N/A'); process.exit(0)\"",
    "test:pulumi": "node -e \"console.log('noop test:pulumi'); process.exit(0)\""
  },
  "devDependencies": {
    "@asamarts/alint": "^0.14.2",
    "@commitlint/cli": "21.2.2",
    "@eslint/js": "^9.26.0",
    "@sargonpiraev/commitlint-config": "file:packages/commitlint-config",
    "@sargonpiraev/eslint-config": "file:packages/eslint-config",
    "@sargonpiraev/prettier-config": "file:packages/prettier-config",
    "@sargonpiraev/semantic-release-config": "file:packages/semantic-release-config",
    "@sargonpiraev/tsconfig": "file:packages/tsconfig",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^30.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lefthook": "2.1.10",
    "multi-semantic-release": "^3.0.2",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.3.2",
    "turbo": "^2.10.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.31.1"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@asamarts/alint@0.14.2": true
  }
}
